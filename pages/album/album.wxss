.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
  background: #fff5f7;
}
.album-header {
  margin-bottom: 28rpx;
}
.album-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}
.album-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
}
.empty {
  margin-top: 120rpx;
  text-align: center;
}
.empty-emoji {
  font-size: 96rpx;
}
.empty-text {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #666;
}
.empty-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #aaa;
}
.card-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.10);
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.card-privacy {
  font-size: 22rpx;
  color: #ff6b81;
  background: #fff0f3;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.card-quote {
  margin: 20rpx 0;
  font-size: 28rpx;
  color: #555;
  font-style: italic;
}
.card-words {
  border-top: 1rpx solid #f3f3f3;
  padding-top: 16rpx;
}
.word {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.word-nick {
  font-size: 24rpx;
  color: #ff6b81;
  width: 96rpx;
  flex-shrink: 0;
  font-weight: 600;
}
.word-text {
  font-size: 26rpx;
  color: #666;
}
.btn-ghost {
  margin-top: 24rpx;
  background: #fff;
  color: #ff6b81;
  border: 1rpx solid #ffd0d8;
  border-radius: 999rpx;
}
