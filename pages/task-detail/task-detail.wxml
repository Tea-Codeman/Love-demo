<view class="page" wx:if="{{task}}">
  <view class="card">
    <view class="task-name">{{task.name}}</view>
    <view class="task-desc">{{task.desc}}</view>
    <view class="mode">{{task.modeText}}</view>
  </view>

  <view class="card">
    <view class="role-title">我（A）的晚安</view>
    <textarea class="ta" placeholder="写下你的晚安…" value="{{aText}}" bindinput="onAInput" disabled="{{task.aDone}}"></textarea>
    <button class="btn-primary" bindtap="completeA" disabled="{{task.aDone}}">{{task.aDone ? '✓ 我已完成' : '我完成'}}</button>
  </view>

  <view class="card">
    <view class="role-title">TA（B）的晚安 · 本机模拟</view>
    <textarea class="ta" placeholder="模拟 TA 写下的晚安…" value="{{bText}}" bindinput="onBInput" disabled="{{task.bDone}}"></textarea>
    <button class="btn-primary" bindtap="completeB" disabled="{{task.bDone}}">{{task.bDone ? '✓ TA 已完成' : '模拟 TA 完成'}}</button>
  </view>

  <view class="card">
    <view class="progress">
      <view class="progress-bar" style="width:{{task.progress}}%"></view>
    </view>
    <view class="task-foot" style="margin-top:12rpx;">{{task.progress}}% 完成</view>
    <button class="btn-go" bindtap="remindTA" disabled="{{task.bDone}}">提醒 TA</button>
  </view>

  <button class="btn-go" bindtap="goComplete" disabled="{{!bothDone}}">查看奖励 & 生成纪念卡 →</button>
</view>
